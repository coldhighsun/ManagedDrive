<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppPrimary" Color="#4C9AEB"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#2F7FD1"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#334C9AEB"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FFE8EAEE"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF9AA1AE"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF9AA1AE"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FF17181C"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FF23252B"/>
    <SolidColorBrush x:Key="AppDivider" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FF383B44"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FF17181C"/>
    <SolidColorBrush x:Key="AppWarning" Color="#F0B04A"/>
    <SolidColorBrush x:Key="AppHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FF17181C"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FFE8EAEE"/>
    <SolidColorBrush x:Key="AppChartWrite" Color="#FF7043"/>

    <!-- Semantic and accent colours (shared by every style; style palettes do not override them). -->
    <SolidColorBrush x:Key="AppWarningSoft" Color="#33F0B04A"/>
    <SolidColorBrush x:Key="AppSuccess" Color="#43C77D"/>
    <SolidColorBrush x:Key="AppSuccessSoft" Color="#3343C77D"/>
    <SolidColorBrush x:Key="AppDanger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="AppDangerSoft" Color="#33FF6B6B"/>
    <SolidColorBrush x:Key="AppInfo" Color="#3CC4DD"/>
    <SolidColorBrush x:Key="AppInfoSoft" Color="#333CC4DD"/>
    <SolidColorBrush x:Key="AppAccent1" Color="#4F8DF7"/>
    <SolidColorBrush x:Key="AppAccent2" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="AppAccent3" Color="#B388F5"/>
    <SolidColorBrush x:Key="AppAccent4" Color="#FF9A4D"/>
    <SolidColorBrush x:Key="AppAccent5" Color="#FF6FA3"/>
    <SolidColorBrush x:Key="AppAccent6" Color="#8B8BFF"/>
    <SolidColorBrush x:Key="AppAccentSoft1" Color="#334F8DF7"/>
    <SolidColorBrush x:Key="AppAccentSoft2" Color="#332DD4BF"/>
    <SolidColorBrush x:Key="AppAccentSoft3" Color="#33B388F5"/>
    <SolidColorBrush x:Key="AppAccentSoft4" Color="#33FF9A4D"/>
    <SolidColorBrush x:Key="AppAccentSoft5" Color="#33FF6FA3"/>
    <SolidColorBrush x:Key="AppAccentSoft6" Color="#338B8BFF"/>

    <!-- Space usage treemap: one colour per file category, plus folders and the merged small-items block. -->
    <SolidColorBrush x:Key="AppSpaceImage" Color="#388E3C"/>
    <SolidColorBrush x:Key="AppSpaceVideo" Color="#7B1FA2"/>
    <SolidColorBrush x:Key="AppSpaceAudio" Color="#00796B"/>
    <SolidColorBrush x:Key="AppSpaceArchive" Color="#D84315"/>
    <SolidColorBrush x:Key="AppSpaceDocument" Color="#1976D2"/>
    <SolidColorBrush x:Key="AppSpaceCode" Color="#303F9F"/>
    <SolidColorBrush x:Key="AppSpaceExecutable" Color="#B71C1C"/>
    <SolidColorBrush x:Key="AppSpaceCache" Color="#616161"/>
    <SolidColorBrush x:Key="AppSpaceOther" Color="#607D8B"/>
    <SolidColorBrush x:Key="AppSpaceFolder" Color="#37474F"/>
    <SolidColorBrush x:Key="AppSpaceMerged" Color="#FF424242"/>

</ResourceDictionary>

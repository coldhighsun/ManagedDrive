<UserControl x:Class="ManagedDrive.App.Controls.CompressionLevelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Slider Grid.Column="0" x:Name="LevelSlider"
                Style="{StaticResource AppSlider}"
                Minimum="0" Maximum="22" Value="1"
                TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="LevelSlider_ValueChanged"/>
        <TextBlock Grid.Column="2" x:Name="LevelText"
                   Foreground="{DynamicResource AppForeground}"
                   VerticalAlignment="Center" MinWidth="64" TextAlignment="Right"/>
    </Grid>
</UserControl>

<Window x:Class="ManagedDrive.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource BorderlessWindowStyle}"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <!-- Glyph and color come from ConfirmDialog.Kind (see the code-behind). -->
            <TextBlock x:Name="KindIcon" Style="{StaticResource IconText}" FontSize="24"/>
            <TextBlock x:Name="TitleText"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontSize="{DynamicResource FontSizeTitle}" FontWeight="Medium"/>
        </StackPanel>

        <!-- Body text -->
        <TextBlock x:Name="BodyText"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   LineHeight="20"
                   Foreground="{DynamicResource AppForeground}"/>

        <!-- Optional checkbox -->
        <CheckBox x:Name="OptionCheckBox"
                  Grid.Row="3"
                  Visibility="Collapsed"
                  Foreground="{DynamicResource AppForeground}"
                  Margin="0,8,0,0"/>

        <!-- Buttons -->
        <StackPanel x:Name="ButtonPanel" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="{DynamicResource Btn.Cancel}" Width="80" IsCancel="True"
                    Style="{StaticResource FlatButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="NeutralButton" Width="80" Visibility="Collapsed"
                    Click="NeutralButton_Click"
                    Style="{StaticResource FlatButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="{DynamicResource Btn.Ok}" Width="80" IsDefault="True"
                    Click="OkButton_Click"
                    Style="{StaticResource RaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>

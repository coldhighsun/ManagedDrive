<views:DialogWindowBase x:Class="ManagedDrive.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ManagedDrive.App.Controls"
        xmlns:views="clr-namespace:ManagedDrive.App.Views"
        Style="{DynamicResource DialogWindowStyle}"
        Title="{DynamicResource Settings.Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fixed MinHeight (tallest tab) so the dialog does not resize when switching tabs; bump it if a tab grows. -->
        <TabControl Grid.Row="0" Style="{StaticResource AppTabControl}" MinHeight="250">

            <!-- General -->
            <TabItem Header="{DynamicResource Settings.Tab.General}">
                <StackPanel>
                    <CheckBox x:Name="RunAtStartupBox"
                              Content="{DynamicResource Settings.RunAtStartup}"
                              ToolTip="{DynamicResource Tip.RunAtStartup}"
                              Margin="0,0,0,12"/>
                    <CheckBox x:Name="StartMinimizedBox"
                              Content="{DynamicResource Settings.StartMinimized}"
                              ToolTip="{DynamicResource Tip.StartMinimized}"
                              Margin="0,0,0,12"/>
                    <CheckBox x:Name="CloseToTrayBox"
                              Content="{DynamicResource Settings.CloseToTray}"
                              ToolTip="{DynamicResource Tip.CloseToTray}"
                              Margin="0,0,0,12"/>
                    <CheckBox x:Name="ContextMenuEnabledBox"
                              ToolTip="{DynamicResource Tip.ContextMenuEnabled}"
                              Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Settings.ContextMenuEnabled}"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="AutoCheckForUpdatesBox"
                              Content="{DynamicResource Settings.AutoCheckForUpdates}"
                              ToolTip="{DynamicResource Tip.AutoCheckForUpdates}"/>
                </StackPanel>
            </TabItem>

            <!-- Appearance -->
            <TabItem Header="{DynamicResource Settings.Tab.Appearance}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{DynamicResource Settings.Language}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              x:Name="LanguageBox"
                              Style="{StaticResource OutlinedComboBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{DynamicResource Settings.Theme}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              x:Name="ThemeBox"
                              Style="{StaticResource OutlinedComboBox}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="{DynamicResource Settings.Style}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              x:Name="StyleBox"
                              Style="{StaticResource OutlinedComboBox}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Text="{DynamicResource Settings.Font}"
                               ToolTip="{DynamicResource Tip.Font}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="6" Grid.Column="1"
                              x:Name="FontBox"
                              ToolTip="{DynamicResource Tip.Font}"
                              Style="{StaticResource OutlinedComboBox}"
                              ScrollViewer.CanContentScroll="True">
                        <!-- Hundreds of fonts: lay out only the rows in view. The fixed width keeps the popup from
                             resizing with the rows that happen to be in view. -->
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </Grid>
            </TabItem>

            <!-- Disks and diagnostics -->
            <TabItem Header="{DynamicResource Settings.Tab.Disk}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Default compression level for new disks -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{DynamicResource Settings.DefaultCompressionLevel}"
                               ToolTip="{DynamicResource Tip.DefaultCompressionLevel}"
                               VerticalAlignment="Center"/>
                    <controls:CompressionLevelPicker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                     x:Name="DefaultCompressionLevelBox"
                                                     ToolTip="{DynamicResource Tip.DefaultCompressionLevel}"/>

                    <!-- Default directory for new disk image files -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{DynamicResource Settings.DefaultImageDirectory}"
                               ToolTip="{DynamicResource Tip.DefaultImageDirectory}"
                               VerticalAlignment="Center"/>
                    <!-- Read-only: clicking the box (or Enter/Space in it) opens the folder picker, so the path is always one that was picked;
                         the button next to it clears the setting. -->
                    <TextBox Grid.Row="2" Grid.Column="1"
                             x:Name="DefaultImageDirectoryBox"
                             IsReadOnly="True" Cursor="Hand"
                             ToolTip="{DynamicResource Tip.DefaultImageDirectory}"
                             Style="{StaticResource OutlinedTextBox}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"
                             PreviewMouseLeftButtonDown="DefaultImageDirectoryBox_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="DefaultImageDirectoryBox_PreviewKeyDown"
                             TextChanged="DefaultImageDirectoryBox_TextChanged"/>
                    <Button Grid.Row="2" Grid.Column="2"
                            x:Name="ClearDefaultImageDirectoryButton"
                            Content="&#xD7;" Width="40" IsEnabled="False"
                            ToolTip="{DynamicResource Tip.ClearDefaultImageDirectory}"
                            AutomationProperties.Name="{DynamicResource Tip.ClearDefaultImageDirectory}"
                            Click="ClearDefaultImageDirectory_Click"
                            Style="{StaticResource OutlinedButton}"/>

                    <!-- Helper service status -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="{DynamicResource Settings.HelperServiceStatus}"
                               ToolTip="{DynamicResource Tip.HelperServiceStatus}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                               x:Name="HelperServiceStatusText"
                               ToolTip="{DynamicResource Tip.HelperServiceStatus}"
                               VerticalAlignment="Center"/>

                    <!-- Open log directory -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Button x:Name="OpenLogDirectoryButton"
                                Content="{DynamicResource Settings.OpenLogDirectory}"
                                Click="OpenLogDirectory_Click"
                                Style="{StaticResource OutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn.Cancel}" Width="80" IsCancel="True"
                    Style="{StaticResource FlatButton}"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn.Ok}" Width="80" IsDefault="True"
                    Click="OK_Click"
                    Style="{StaticResource RaisedButton}"/>
        </StackPanel>
    </Grid>
</views:DialogWindowBase>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppPrimary" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#0C5A9E"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#FFE1ECFB"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF5F6672"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF5F6672"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AppDivider" Color="#1F000000"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FFE3E6EC"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="AppWarning" Color="#E08A00"/>
    <SolidColorBrush x:Key="AppHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1A000000"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="AppChartWrite" Color="#E64A19"/>

    <!-- Space usage treemap: one colour per file category, plus folders and the merged small-items block. -->
    <SolidColorBrush x:Key="AppSpaceImage" Color="#43A047"/>
    <SolidColorBrush x:Key="AppSpaceVideo" Color="#8E24AA"/>
    <SolidColorBrush x:Key="AppSpaceAudio" Color="#00897B"/>
    <SolidColorBrush x:Key="AppSpaceArchive" Color="#F4511E"/>
    <SolidColorBrush x:Key="AppSpaceDocument" Color="#1E88E5"/>
    <SolidColorBrush x:Key="AppSpaceCode" Color="#3949AB"/>
    <SolidColorBrush x:Key="AppSpaceExecutable" Color="#C62828"/>
    <SolidColorBrush x:Key="AppSpaceCache" Color="#757575"/>
    <SolidColorBrush x:Key="AppSpaceOther" Color="#78909C"/>
    <SolidColorBrush x:Key="AppSpaceFolder" Color="#455A64"/>
    <SolidColorBrush x:Key="AppSpaceMerged" Color="#CFD8DC"/>

</ResourceDictionary>

<views:DialogWindowBase x:Class="ManagedDrive.App.Views.SpaceUsageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ManagedDrive.App.Views"
        xmlns:controls="clr-namespace:ManagedDrive.App.Controls"
        xmlns:infra="clr-namespace:ManagedDrive.App.Infrastructure"
        Style="{StaticResource DialogWindowStyle}"
        Title="{DynamicResource SpaceUsage.Title}"
        Width="980" Height="640"
        MinWidth="760" MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <views:DialogWindowBase.Resources>
        <!-- Flat column header and rows, as in the disk-content dialog, without its event hooks. -->
        <Style x:Key="FlatGridViewColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundLight}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="4,0,4,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,1,1"
                                    BorderBrush="{DynamicResource AppDivider}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The toolbar icon button is made for the coloured app bar (white text, white hover); this is its
             counterpart on the dialog surface. -->
        <Style x:Key="SurfaceIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppDivider}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppDivider}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatListViewItem" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppDivider}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppDivider}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-aligned text cell; padding keeps the last character off the clip edge. -->
        <DataTemplate x:Key="SizeCell" DataType="{x:Type views:SpaceRow}">
            <TextBlock Text="{Binding Size}" TextAlignment="Right" Width="69"
                       Foreground="{DynamicResource AppForegroundLight}"/>
        </DataTemplate>
        <DataTemplate x:Key="ShareCell" DataType="{x:Type views:SpaceRow}">
            <TextBlock Text="{Binding Share}" TextAlignment="Right" Width="49"
                       Foreground="{DynamicResource AppForegroundLight}"/>
        </DataTemplate>
        <DataTemplate x:Key="FilesCell" DataType="{x:Type views:SpaceRow}">
            <TextBlock Text="{Binding Files}" TextAlignment="Right" Width="44"
                       Foreground="{DynamicResource AppForegroundLight}"/>
        </DataTemplate>
        <DataTemplate x:Key="ExtensionCell" DataType="{x:Type views:SpaceRow}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AppForeground}"/>
        </DataTemplate>
        <infra:SpaceSwatchConverter x:Key="SpaceSwatchConverter"/>
        <DataTemplate x:Key="SwatchCell" DataType="{x:Type views:SpaceRow}">
            <!-- Tag is only a theme-dependent input: when the theme changes it changes, the converter runs again and
                 looks the colour up in the new theme, so the list itself is not touched. -->
            <Border Width="12" Height="12" CornerRadius="2" HorizontalAlignment="Center"
                    Tag="{DynamicResource AppSpaceOther}">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource SpaceSwatchConverter}">
                        <Binding Path="SwatchKey"/>
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </Border.Background>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="NameCell" DataType="{x:Type views:SpaceRow}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AppForeground}"/>
        </DataTemplate>
    </views:DialogWindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource AppForegroundLight}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource SpaceUsage.ListSize}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}"/>
                <TextBox x:Name="TopCountBox" Width="56" Margin="6,0,0,0" VerticalAlignment="Center"
                         Style="{StaticResource OutlinedTextBox}" Padding="6,4"
                         MaxLength="4" TextAlignment="Right"
                         ToolTip="{DynamicResource SpaceUsage.ListSizeTip}"
                         AutomationProperties.Name="{DynamicResource SpaceUsage.ListSize}"
                         PreviewTextInput="TopCountBox_PreviewTextInput"
                         KeyDown="TopCountBox_KeyDown"
                         LostFocus="TopCountBox_LostFocus"/>
                <Button x:Name="RefreshButton"
                        Style="{StaticResource SurfaceIconButton}" Width="32" Height="32" Margin="8,0,0,0"
                        ToolTip="{DynamicResource SpaceUsage.Refresh}"
                        AutomationProperties.Name="{DynamicResource SpaceUsage.Refresh}"
                        Click="RefreshButton_Click">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="UpButton" Content="{DynamicResource SpaceUsage.Up}"
                    Style="{StaticResource RaisedButton}" Padding="12,0" IsEnabled="False"
                    Click="UpButton_Click"/>
            <TextBlock x:Name="PathText" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppForeground}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="410" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SectionBorder}" Padding="0">
                    <Grid>
                        <controls:TreemapControl x:Name="Treemap"
                                                 DirectoryChanged="Treemap_DirectoryChanged"
                                                 SelectionChanged="Treemap_SelectionChanged"
                                                 OpenInExplorerRequested="Treemap_OpenInExplorerRequested"
                                                 DeleteRequested="Treemap_DeleteRequested"/>
                        <TextBlock x:Name="EmptyText" Text="{DynamicResource SpaceUsage.Empty}"
                                   Foreground="{DynamicResource AppForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <Border x:Name="BusyOverlay" Background="{DynamicResource AppSurface}" Opacity="0.85">
                            <TextBlock x:Name="BusyText" Text="{DynamicResource SpaceUsage.Analyzing}"
                                       Foreground="{DynamicResource AppForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="2" x:Name="LegendPanel"/>
            </Grid>

            <TabControl Grid.Column="2" Style="{StaticResource AppTabControl}">
                <TabItem Header="{DynamicResource SpaceUsage.TabFolders}">
                    <ListView x:Name="FolderList" BorderThickness="0" Background="Transparent"
                              ItemContainerStyle="{StaticResource FlatListViewItem}"
                              MouseDoubleClick="List_MouseDoubleClick"
                              PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource FlatGridViewColumnHeader}">
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnName}" Width="210" CellTemplate="{StaticResource NameCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnSize}" Width="85" CellTemplate="{StaticResource SizeCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnShare}" Width="65" CellTemplate="{StaticResource ShareCell}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem Header="{DynamicResource SpaceUsage.TabFiles}">
                    <ListView x:Name="FileList" BorderThickness="0" Background="Transparent"
                              ItemContainerStyle="{StaticResource FlatListViewItem}"
                              MouseDoubleClick="List_MouseDoubleClick"
                              PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource FlatGridViewColumnHeader}">
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnName}" Width="210" CellTemplate="{StaticResource NameCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnSize}" Width="85" CellTemplate="{StaticResource SizeCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnShare}" Width="65" CellTemplate="{StaticResource ShareCell}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem Header="{DynamicResource SpaceUsage.TabExtensions}">
                    <ListView x:Name="ExtensionList" BorderThickness="0" Background="Transparent"
                              ItemContainerStyle="{StaticResource FlatListViewItem}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource FlatGridViewColumnHeader}">
                                <GridViewColumn Width="24" CellTemplate="{StaticResource SwatchCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnName}" Width="66" CellTemplate="{StaticResource ExtensionCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnSize}" Width="85" CellTemplate="{StaticResource SizeCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnShare}" Width="65" CellTemplate="{StaticResource ShareCell}"/>
                                <GridViewColumn Header="{DynamicResource SpaceUsage.ColumnFiles}" Width="60" CellTemplate="{StaticResource FilesCell}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="6" x:Name="StatusText" Foreground="{DynamicResource AppForegroundLight}"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn.Close}" Width="80" IsDefault="True" IsCancel="True"
                    Style="{StaticResource RaisedButton}"/>
        </StackPanel>
    </Grid>
</views:DialogWindowBase>

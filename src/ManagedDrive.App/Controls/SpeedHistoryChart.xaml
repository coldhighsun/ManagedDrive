<UserControl x:Class="ManagedDrive.App.Controls.SpeedHistoryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <!-- One mirrored chart: the read speed rises above the zero line in the middle and the write speed falls below it,
         both on the same scale, so the two series never overlap. Each series has a translucent area under its line. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Legend: read is above the zero line, write below it -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Rectangle Width="10" Height="10" Fill="{DynamicResource AppPrimary}" Margin="0,0,4,0"/>
            <TextBlock Text="{DynamicResource Card.ReadSpeed}" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource AppForegroundLight}"/>
            <StackPanel x:Name="WriteLegend" Orientation="Horizontal">
                <Rectangle Width="10" Height="10" Fill="{DynamicResource AppChartWrite}" Margin="16,0,4,0"/>
                <TextBlock Text="{DynamicResource Card.WriteSpeed}" FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource AppForegroundLight}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
            <TextBlock x:Name="AxisTopLabel" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Foreground="{DynamicResource AppForegroundLight}"/>
            <TextBlock x:Name="AxisZeroLabel" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppForegroundLight}"/>
            <TextBlock x:Name="AxisBottomLabel" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource AppForegroundLight}"/>
        </Grid>
        <Grid x:Name="ChartArea" Grid.Row="1" Grid.Column="1" ClipToBounds="True" Background="Transparent"
              SizeChanged="ChartArea_SizeChanged" MouseMove="ChartArea_MouseMove" MouseLeave="ChartArea_MouseLeave">
            <Line x:Name="TopGridLine" Stroke="{DynamicResource AppDivider}" StrokeThickness="1" StrokeDashArray="2,2"/>
            <Line x:Name="BottomGridLine" Stroke="{DynamicResource AppDivider}" StrokeThickness="1" StrokeDashArray="2,2"/>
            <Polygon x:Name="ReadArea" Fill="{DynamicResource AppPrimary}" Opacity="0.25"/>
            <Polygon x:Name="WriteArea" Fill="{DynamicResource AppChartWrite}" Opacity="0.25"/>
            <!-- The zero line, on top of the areas -->
            <Line x:Name="MidGridLine" Stroke="{DynamicResource AppForegroundLight}" StrokeThickness="1" Opacity="0.5"/>
            <Polyline x:Name="ReadLine" Stroke="{DynamicResource AppPrimary}" StrokeThickness="2"
                      StrokeLineJoin="Round"/>
            <Polyline x:Name="WriteLine" Stroke="{DynamicResource AppChartWrite}" StrokeThickness="2"
                      StrokeLineJoin="Round"/>

            <!-- Hover crosshair: a vertical dashed line at the hovered sample, a horizontal one at each series' value,
                 a dot on each curve and an info box with the time and speeds. Hidden until the mouse is over the plot. -->
            <Line x:Name="HoverVLine" Stroke="{DynamicResource AppForegroundLight}" StrokeThickness="1"
                  StrokeDashArray="3,3" Opacity="0.7" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Line x:Name="HoverReadLine" Stroke="{DynamicResource AppPrimary}" StrokeThickness="1"
                  StrokeDashArray="3,3" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Line x:Name="HoverWriteLine" Stroke="{DynamicResource AppChartWrite}" StrokeThickness="1"
                  StrokeDashArray="3,3" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="HoverReadDot" Width="7" Height="7" Fill="{DynamicResource AppPrimary}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Ellipse x:Name="HoverWriteDot" Width="7" Height="7" Fill="{DynamicResource AppChartWrite}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="HoverInfo" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppDivider}"
                    BorderThickness="1" CornerRadius="{DynamicResource PopupCornerRadius}" Padding="6,4"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="HoverTimeText" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource AppForegroundLight}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource AppPrimary}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="HoverReadText" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource AppForegroundLight}"/>
                    </StackPanel>
                    <StackPanel x:Name="HoverWriteRow" Orientation="Horizontal" Margin="0,2,0,0">
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource AppChartWrite}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="HoverWriteText" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource AppForegroundLight}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeAxisLabel0" Grid.Column="0" FontSize="10" HorizontalAlignment="Left"
                       Foreground="{DynamicResource AppForegroundLight}"/>
            <TextBlock x:Name="TimeAxisLabel1" Grid.Column="0" FontSize="10" HorizontalAlignment="Right"
                       Foreground="{DynamicResource AppForegroundLight}"/>
            <TextBlock x:Name="TimeAxisLabel2" Grid.Column="1" FontSize="10" HorizontalAlignment="Right"
                       Foreground="{DynamicResource AppForegroundLight}"/>
            <TextBlock x:Name="TimeAxisLabel3" Grid.Column="2" FontSize="10" HorizontalAlignment="Right"
                       Foreground="{DynamicResource AppForegroundLight}"/>
        </Grid>
    </Grid>
</UserControl>

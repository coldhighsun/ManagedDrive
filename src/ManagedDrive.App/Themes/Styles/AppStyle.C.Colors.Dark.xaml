<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Style C (minimal), dark: near-black, white accent. Merged after the theme's colors by StyleManager, so these win. -->

    <SolidColorBrush x:Key="AppPrimary" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="#FF121212"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF9A9A94"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF9A9A94"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FF121212"/>
    <SolidColorBrush x:Key="AppDivider" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="AppWarning" Color="#FFF0B04A"/>
    <SolidColorBrush x:Key="AppHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FF121212"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FFEDEDED"/>

</ResourceDictionary>

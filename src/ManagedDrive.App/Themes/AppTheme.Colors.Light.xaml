<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppPrimary" Color="#3F51B5"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#303F9F"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FF000000"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#BF000000"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#99000000"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppDivider" Color="#33000000"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FFDADADA"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AppWarning" Color="#FF9800"/>
    <SolidColorBrush x:Key="AppHover" Color="#0A000000"/>
    <SolidColorBrush x:Key="AppPressed" Color="#14000000"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#3F51B5"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="White"/>
    <SolidColorBrush x:Key="AppChartWrite" Color="#E64A19"/>

    <!-- Space usage treemap: one colour per file category, plus folders and their frames. -->
    <SolidColorBrush x:Key="AppSpaceImage" Color="#43A047"/>
    <SolidColorBrush x:Key="AppSpaceVideo" Color="#8E24AA"/>
    <SolidColorBrush x:Key="AppSpaceAudio" Color="#00897B"/>
    <SolidColorBrush x:Key="AppSpaceArchive" Color="#F4511E"/>
    <SolidColorBrush x:Key="AppSpaceDocument" Color="#1E88E5"/>
    <SolidColorBrush x:Key="AppSpaceCode" Color="#3949AB"/>
    <SolidColorBrush x:Key="AppSpaceExecutable" Color="#C62828"/>
    <SolidColorBrush x:Key="AppSpaceCache" Color="#757575"/>
    <SolidColorBrush x:Key="AppSpaceOther" Color="#78909C"/>
    <SolidColorBrush x:Key="AppSpaceFolder" Color="#455A64"/>
    <SolidColorBrush x:Key="AppSpaceContainer" Color="#ECEFF1"/>
    <SolidColorBrush x:Key="AppSpaceContainerHeader" Color="#CFD8DC"/>

</ResourceDictionary>

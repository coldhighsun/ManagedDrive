<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppPrimary" Color="#5C6BC0"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#3F51B5"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#DDFFFFFF"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#89FFFFFF"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#89FFFFFF"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="AppDivider" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FF4D4D4D"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="AppWarning" Color="#FFB74D"/>
    <SolidColorBrush x:Key="AppHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#DDFFFFFF"/>
    <SolidColorBrush x:Key="AppChartWrite" Color="#FF7043"/>

    <!-- Space usage treemap: one colour per file category, plus folders and their frames. -->
    <SolidColorBrush x:Key="AppSpaceImage" Color="#388E3C"/>
    <SolidColorBrush x:Key="AppSpaceVideo" Color="#7B1FA2"/>
    <SolidColorBrush x:Key="AppSpaceAudio" Color="#00796B"/>
    <SolidColorBrush x:Key="AppSpaceArchive" Color="#D84315"/>
    <SolidColorBrush x:Key="AppSpaceDocument" Color="#1976D2"/>
    <SolidColorBrush x:Key="AppSpaceCode" Color="#303F9F"/>
    <SolidColorBrush x:Key="AppSpaceExecutable" Color="#B71C1C"/>
    <SolidColorBrush x:Key="AppSpaceCache" Color="#616161"/>
    <SolidColorBrush x:Key="AppSpaceOther" Color="#607D8B"/>
    <SolidColorBrush x:Key="AppSpaceFolder" Color="#37474F"/>
    <SolidColorBrush x:Key="AppSpaceContainer" Color="#FF333333"/>
    <SolidColorBrush x:Key="AppSpaceContainerHeader" Color="#FF424242"/>

</ResourceDictionary>

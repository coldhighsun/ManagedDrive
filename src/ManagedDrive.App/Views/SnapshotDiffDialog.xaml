<views:DialogWindowBase x:Class="ManagedDrive.App.Views.SnapshotDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ManagedDrive.App.Views"
        Style="{DynamicResource DialogWindowStyle}"
        Title="{DynamicResource SnapshotDiff.Title}"
        Width="560" Height="560"
        MinWidth="440" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <views:DialogWindowBase.Resources>
        <!-- A filter card: coloured by its Background/Foreground, outlined when selected. -->
        <Style x:Key="DiffFilterCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="{DynamicResource SectionCornerRadius}" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Keyboard focus ring (the default focus visual is switched off above);
                                 listed before IsChecked so the selection outline wins. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppForegroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AppPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiffCardNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DiffCardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
        </Style>

        <!-- Round badge on each row: tinted by the kind of change. -->
        <Style x:Key="DiffBadge" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AppHover}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Restored">
                    <Setter Property="Background" Value="{DynamicResource AppSuccessSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Background" Value="{DynamicResource AppDangerSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Reverted">
                    <Setter Property="Background" Value="{DynamicResource AppWarningSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The sign is drawn as a stroke in the badge's own 20x20 space, not as a text glyph,
             so it is centred exactly whatever the font's line metrics are. -->
        <Style x:Key="DiffBadgeGlyph" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource AppForeground}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Restored">
                    <Setter Property="Stroke" Value="{DynamicResource AppSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Stroke" Value="{DynamicResource AppDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Reverted">
                    <Setter Property="Stroke" Value="{DynamicResource AppWarning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <views:DepthToIndentConverter x:Key="DepthToIndentConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One row of the folder tree: indent by depth, expander (folders with visible children), change badge,
             icon, name and, for a folder, how many changed files lie below it. -->
        <DataTemplate DataType="{x:Type views:DiffTreeNode}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}"
                        Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}">
                <Border Width="16" Height="16">
                    <Button Padding="0"
                            Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock FontSize="10" Foreground="{DynamicResource AppForegroundLight}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                    <Setter Property="Text" Value="&#xE76C;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Border>
                <Border Style="{StaticResource DiffBadge}" Margin="4,0,0,0">
                    <Path Data="{Binding BadgeData}" Style="{StaticResource DiffBadgeGlyph}"/>
                </Border>
                <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource IconText}"
                           FontSize="14" Foreground="{DynamicResource AppForegroundLight}" Margin="10,0,6,0"/>
                <TextBlock Text="{Binding Name}" FontWeight="Medium"
                           Foreground="{DynamicResource AppForeground}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" Margin="8,0,0,0"
                           Foreground="{DynamicResource AppForegroundLight}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </views:DialogWindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="SourceDescriptionText"
                   Foreground="{DynamicResource AppForeground}"
                   TextWrapping="Wrap"/>

        <!-- Filter cards (double as the summary) -->
        <Grid Grid.Row="2" x:Name="CardsPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton Grid.Column="0" x:Name="AllCard" GroupName="DiffFilter"
                         Style="{StaticResource DiffFilterCard}"
                         Background="{DynamicResource AppHover}"
                         Checked="Filter_Checked">
                <StackPanel>
                    <TextBlock x:Name="AllCountText" Style="{StaticResource DiffCardNumber}"
                               Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock Text="{DynamicResource SnapshotDiff.Filter.All}" Style="{StaticResource DiffCardLabel}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Grid.Column="2" x:Name="RestoredCard" GroupName="DiffFilter"
                         Style="{StaticResource DiffFilterCard}"
                         Background="{DynamicResource AppSuccessSoft}"
                         ToolTip="{DynamicResource Tip.SnapshotDiff.Restored}"
                         Checked="Filter_Checked">
                <StackPanel>
                    <TextBlock x:Name="RestoredCountText" Style="{StaticResource DiffCardNumber}"
                               Foreground="{DynamicResource AppSuccess}"/>
                    <TextBlock Text="{DynamicResource SnapshotDiff.Filter.Restored}" Style="{StaticResource DiffCardLabel}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Grid.Column="4" x:Name="RemovedCard" GroupName="DiffFilter"
                         Style="{StaticResource DiffFilterCard}"
                         Background="{DynamicResource AppDangerSoft}"
                         ToolTip="{DynamicResource Tip.SnapshotDiff.Removed}"
                         Checked="Filter_Checked">
                <StackPanel>
                    <TextBlock x:Name="RemovedCountText" Style="{StaticResource DiffCardNumber}"
                               Foreground="{DynamicResource AppDanger}"/>
                    <TextBlock Text="{DynamicResource SnapshotDiff.Filter.Removed}" Style="{StaticResource DiffCardLabel}"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Grid.Column="6" x:Name="RevertedCard" GroupName="DiffFilter"
                         Style="{StaticResource DiffFilterCard}"
                         Background="{DynamicResource AppWarningSoft}"
                         ToolTip="{DynamicResource Tip.SnapshotDiff.Reverted}"
                         Checked="Filter_Checked">
                <StackPanel>
                    <TextBlock x:Name="RevertedCountText" Style="{StaticResource DiffCardNumber}"
                               Foreground="{DynamicResource AppWarning}"/>
                    <TextBlock Text="{DynamicResource SnapshotDiff.Filter.Reverted}" Style="{StaticResource DiffCardLabel}"/>
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- Shown while the comparison runs; the dialog opens before it finishes. -->
        <StackPanel Grid.Row="2" Grid.RowSpan="3" x:Name="LoadingPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="32"
                       Foreground="{DynamicResource AppPrimary}"
                       HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="{DynamicResource SnapshotDiff.Loading}" Margin="0,12,0,0"
                       Foreground="{DynamicResource AppForegroundLight}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="4" x:Name="ResultBorder" Visibility="Collapsed" Style="{DynamicResource SectionBorder}">
            <DockPanel LastChildFill="True">
                <!-- Empty state -->
                <StackPanel x:Name="NoChangesPanel" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,16"
                            Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="28"
                               Foreground="{DynamicResource AppSuccess}"/>
                    <TextBlock x:Name="NoChangesText"
                               Text="{DynamicResource SnapshotDiff.NoChanges}"
                               Foreground="{DynamicResource AppForeground}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock x:Name="UnchangedText"
                           DockPanel.Dock="Bottom"
                           Foreground="{DynamicResource AppForegroundLight}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Margin="8,8,0,0"/>

                <ListBox x:Name="ChangesList"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource AppForeground}"
                         ItemContainerStyle="{StaticResource DialogListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         ButtonBase.Click="Expander_Click"
                         MouseDoubleClick="ChangesList_MouseDoubleClick"
                         VirtualizingStackPanel.IsVirtualizing="True"/>
            </DockPanel>
        </Border>

        <!-- Close -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn.Close}" Width="80" IsDefault="True" IsCancel="True"
                    Style="{StaticResource RaisedButton}"/>
        </StackPanel>
    </Grid>
</views:DialogWindowBase>

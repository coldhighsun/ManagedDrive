<Window x:Class="ManagedDrive.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="ManagedDrive"
        Width="560" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ManagedDrive.ico">

    <Grid Margin="12">
    <!-- The shadow sits on its own, childless border: an effect on the parent of the animated
         content would be re-rendered, blur included, on every frame. -->
    <Border CornerRadius="10" Background="{DynamicResource AppBackground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
    </Border>

    <Border CornerRadius="10"
            BorderBrush="{DynamicResource AppDivider}" BorderThickness="1">
        <Grid x:Name="ClipHost" SizeChanged="ClipHost_SizeChanged">

        <!-- Animated background: soft circles, created in code with random parameters. -->
        <Canvas x:Name="BlobCanvas" IsHitTestVisible="False"/>

        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/ManagedDrive.ico" Width="64" Height="64"
                       HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>
                <TextBlock Text="ManagedDrive" FontSize="20" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Foreground="{DynamicResource AppForegroundMuted}"/>
            </StackPanel>

            <!-- Scrolling feature list; filled and animated by code-behind, which also gives it its
                 fading top and bottom edges (OpacityMask, from SplashTicker.EdgeFadeFraction). -->
            <Canvas x:Name="FeatureViewport" Grid.Row="1" Margin="0,10" ClipToBounds="True"
                    IsHitTestVisible="False">
                <StackPanel x:Name="FeatureList">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="FeatureScroll"/>
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" FontSize="12" Margin="0,0,0,6"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppForeground}"/>
                <ProgressBar x:Name="LoadProgressBar" Style="{StaticResource SlimProgressBar}"
                             Minimum="0" Maximum="1" IsIndeterminate="True"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>

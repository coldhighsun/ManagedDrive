<views:DialogWindowBase x:Class="ManagedDrive.App.Views.CloneDiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ManagedDrive.App.Helpers"
        xmlns:controls="clr-namespace:ManagedDrive.App.Controls"
        xmlns:views="clr-namespace:ManagedDrive.App.Views"
        Style="{DynamicResource DialogWindowStyle}"
        Title="{DynamicResource CloneDisk.Title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="SourceDescriptionText"
                   Foreground="{DynamicResource AppForeground}"
                   TextWrapping="Wrap"/>

        <!-- Clone to another mounted disk -->
        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource SettingsGroupStyle}">
                <StackPanel>
                    <RadioButton x:Name="CloneToDiskOption" GroupName="CloneMode"
                                 Content="{DynamicResource CloneDisk.ToDisk}"
                                 Foreground="{DynamicResource AppForeground}"
                                 Checked="ModeOption_CheckedChanged"/>

                    <ComboBox x:Name="TargetDiskBox" IsEditable="False" Margin="0,8,0,8"
                              Style="{StaticResource OutlinedComboBox}"/>

                    <TextBlock Text="{DynamicResource CloneDisk.ToDiskWarning}"
                               Foreground="{DynamicResource AppWarning}"
                               FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Export as a new .mdr image file -->
            <Border Style="{StaticResource SettingsGroupStyle}" Margin="0">
                <StackPanel>
                    <RadioButton x:Name="ExportToFileOption" GroupName="CloneMode"
                                 Content="{DynamicResource CloneDisk.ToFile}"
                                 Foreground="{DynamicResource AppForeground}"
                                 Checked="ModeOption_CheckedChanged"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource CloneDisk.ExportFormat}"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Grid.Row="0" Grid.Column="2" x:Name="ExportFormatBox" IsEditable="False"
                                  Style="{StaticResource OutlinedComboBox}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource CreateDisk.CompressionLevel}"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <controls:CompressionLevelPicker Grid.Row="2" Grid.Column="2" x:Name="CompressionLevelBox"/>
                    </Grid>

                    <TextBox Margin="0,8,0,0" x:Name="ExportPathBox" IsReadOnly="True" Cursor="Hand"
                             helpers:HintHelper.Text="{DynamicResource CloneDisk.ExportFile}"
                             Style="{StaticResource OutlinedTextBox}"
                             PreviewMouseLeftButtonDown="ExportPathBox_PreviewMouseLeftButtonDown"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn.Cancel}" Width="80" IsCancel="True"
                    Style="{StaticResource FlatButton}"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Btn.Ok}" Width="80" IsDefault="True"
                    Click="OK_Click"
                    Style="{StaticResource RaisedButton}"/>
        </StackPanel>
    </Grid>
</views:DialogWindowBase>

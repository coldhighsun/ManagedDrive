<Window x:Class="ManagedDrive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ManagedDrive.App.ViewModels"
        xmlns:controls="clr-namespace:ManagedDrive.App.Controls"
        mc:Ignorable="d"
        Style="{DynamicResource BorderlessWindowStyle}"
        Icon="pack://application:,,,/ManagedDrive.ico"
        Title="{DynamicResource Window.Title}"
        Height="480" Width="760"
        MinHeight="360" MinWidth="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource AppForeground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding CreateDiskCommand}"/>
        <KeyBinding Modifiers="Control" Key="I" Command="{Binding ImportDiskCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveImageCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding UnmountCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding SettingsCommand}"/>
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Grid>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar background: only some styles show one (the tool buttons then sit on it). -->
        <Border Style="{DynamicResource SidebarStyle}"/>

        <!-- App bar -->
        <Border Style="{DynamicResource AppBarStyle}">
            <TextBlock VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="{DynamicResource FontSizeTitle}" FontWeight="Medium"
                           Foreground="{DynamicResource AppBarForeground}"
                           Text="{DynamicResource Window.Title}"/>
        </Border>

        <!-- Tool buttons: in the app bar, or in the sidebar, depending on the style. -->
        <StackPanel Style="{DynamicResource ToolButtonsStyle}">
<Button Style="{StaticResource IconButton}"
                            Command="{Binding CreateDiskCommand}"
                            ToolTip="{DynamicResource Tip.NewDisk}"
                            AutomationProperties.Name="{DynamicResource Tip.NewDisk}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;"
                                   Foreground="{DynamicResource ToolIconNew}"/>
                    </Button>
                    <Button x:Name="ImportBtn" Style="{StaticResource IconButton}"
                            Click="ImportBtn_Click"
                            ToolTip="{DynamicResource Tip.Import}"
                            AutomationProperties.Name="{DynamicResource Tip.Import}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Btn.ImportDisk}"
                                          ToolTip="{DynamicResource Tip.ImportDisk}"
                                          Command="{Binding ImportDiskCommand}"/>
                                <MenuItem Header="{DynamicResource Btn.ImportArchive}"
                                          ToolTip="{DynamicResource Tip.ImportArchive}"
                                          Command="{Binding ImportArchiveCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;"
                                   Foreground="{DynamicResource ToolIconImport}"/>
                    </Button>
                    <Button x:Name="RestoreEnvBtn" Style="{StaticResource IconButton}"
                            Click="RestoreEnvBtn_Click"
                            ToolTip="{DynamicResource Tip.RestoreEnv}"
                            AutomationProperties.Name="{DynamicResource Tip.RestoreEnv}">
                        <Button.ContextMenu>
                            <!-- Items are created in RestoreEnvBtn_Click, from the variables redirected at that moment. -->
                            <ContextMenu/>
                        </Button.ContextMenu>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;"
                                   Foreground="{DynamicResource ToolIconRestore}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding SettingsCommand}"
                            ToolTip="{DynamicResource Tip.Settings}"
                            AutomationProperties.Name="{DynamicResource Tip.Settings}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"
                                   Foreground="{DynamicResource ToolIconSettings}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding AboutCommand}"
                            ToolTip="{DynamicResource Menu.About}"
                            AutomationProperties.Name="{DynamicResource Menu.About}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE946;"
                                   Foreground="{DynamicResource ToolIconAbout}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ExitCommand}"
                            ToolTip="{DynamicResource Menu.Exit}"
                            AutomationProperties.Name="{DynamicResource Menu.Exit}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;"
                                   Foreground="{DynamicResource ToolIconExit}"/>
                    </Button>
        </StackPanel>

        <!-- Window buttons -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
<Button Style="{StaticResource IconButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="{DynamicResource Tip.Minimize}"
                            AutomationProperties.Name="{DynamicResource Tip.Minimize}">
                        <TextBlock Style="{StaticResource MinimizeIconText}"/>
                    </Button>
                    <Button x:Name="MaximizeBtn" Style="{StaticResource IconButton}"
                            Click="MaximizeButton_Click"
                            ToolTip="{DynamicResource Tip.MaximizeRestore}"
                            AutomationProperties.Name="{DynamicResource Tip.MaximizeRestore}">
                        <TextBlock Style="{StaticResource MaximizeIconText}"/>
                    </Button>
                    <Button Style="{StaticResource CloseIconButton}"
                            Click="CloseButton_Click"
                            ToolTip="{DynamicResource Tip.HideToTray}"
                            AutomationProperties.Name="{DynamicResource Tip.HideToTray}">
                        <TextBlock Style="{StaticResource CloseIconText}"/>
                    </Button>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{DynamicResource AppToolBarBackground}"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding AvailableMemoryFormatted}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource AppForegroundLight}"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"
                           ToolTip="{Binding StatusText}"
                           Foreground="{DynamicResource AppForegroundLight}"/>
            </DockPanel>
        </Border>

        <!-- Disk card list (with empty-state guidance overlaid when no disks are mounted) -->
        <Grid Grid.Row="1" Grid.Column="1">
        <ListBox x:Name="DiskList"
                 ItemsSource="{Binding Disks}"
                 ItemTemplate="{DynamicResource DiskCardTemplate}"
                 SelectedItem="{Binding SelectedDisk}"
                 SelectionChanged="DiskList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,4"
                 Tag="{Binding}">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Btn.NewDisk}"
                              Command="{Binding PlacementTarget.Tag.CreateDiskCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="{DynamicResource Btn.ImportDisk}"
                              ToolTip="{DynamicResource Tip.ImportDisk}"
                              Command="{Binding PlacementTarget.Tag.ImportDiskCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="{DynamicResource Btn.ImportArchive}"
                              ToolTip="{DynamicResource Tip.ImportArchive}"
                              Command="{Binding PlacementTarget.Tag.ImportArchiveCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Empty state: shown when no disks are mounted -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="320" Margin="24"
                    IsHitTestVisible="{Binding IsEmpty}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <Border Width="72" Height="72" CornerRadius="16"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppDivider}" BorderThickness="1"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" FontSize="34"
                           Foreground="{DynamicResource AppForegroundLight}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource Empty.Title}"
                       FontSize="{DynamicResource FontSizeTitle}" FontWeight="Medium"
                       Foreground="{DynamicResource AppForeground}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="{DynamicResource Empty.Subtitle}"
                       FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource AppForegroundLight}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Style="{StaticResource RaisedButton}"
                        Content="{DynamicResource Btn.NewDisk}"
                        Command="{Binding CreateDiskCommand}"/>
                <Button Style="{StaticResource OutlinedButton}"
                        Content="{DynamicResource Btn.ImportDisk}"
                        Command="{Binding ImportDiskCommand}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
        </Grid>

    </Grid>

    <!-- Exit saving overlay -->
    <Border Background="{DynamicResource AppSurface}"
            Opacity="0.92"
            Visibility="{Binding IsExiting, Converter={StaticResource BoolToVis}}"
            Panel.ZIndex="100">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="20"
                           Foreground="{DynamicResource AppPrimary}"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="ExitSpinnerRotate" Angle="0"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExiting}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ExitSpinStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                  From="0" To="360" Duration="0:0:1"
                                                                  RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ExitSpinStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ExitSaveStatusText}" FontSize="14" Margin="8,0,0,0"
                           Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ExitSaveDetailText}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,4"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppForeground}" Opacity="0.7"/>
            <ProgressBar Style="{StaticResource SlimProgressBar}"
                         Minimum="0" Maximum="1"
                         Value="{Binding ExitSaveProgress, Mode=OneWay}"/>
        </StackPanel>
    </Border>

    <!-- Busy/progress overlay for save/import/export operations -->
    <Border Background="{DynamicResource AppSurface}"
            Opacity="0.92"
            Visibility="{Binding BusyOverlay.IsBusy, Converter={StaticResource BoolToVis}}"
            Panel.ZIndex="90">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
            <TextBlock Text="{Binding BusyOverlay.StatusText}" FontSize="14" Margin="0,0,0,8"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppForeground}"/>
            <TextBlock Text="{Binding BusyOverlay.DetailText}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,4"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppForeground}" Opacity="0.7"/>
            <ProgressBar Style="{StaticResource SlimProgressBar}"
                         Minimum="0" Maximum="1"
                         Value="{Binding BusyOverlay.Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding BusyOverlay.IsIndeterminate}"/>
            <Button Content="{DynamicResource Btn.Cancel}" Width="80"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource FlatButton}"
                    Command="{Binding BusyOverlay.CancelCommand}"
                    Visibility="{Binding BusyOverlay.CanCancel, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>

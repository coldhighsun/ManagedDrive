<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Style B (dashboard), light: cool grey with white cards and a blue accent. Merged after the theme's colors by StyleManager, so these win. -->

    <SolidColorBrush x:Key="AppPrimary" Color="#FF2B6CF0"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#FF1F55C4"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#1F2B6CF0"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FF1B1E27"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF5F6676"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF5F6676"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AppDivider" Color="#FFE2E6EE"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FFE2E6EE"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="AppWarning" Color="#FFB26A00"/>
    <SolidColorBrush x:Key="AppWarningSoft" Color="#26D98200"/>
    <SolidColorBrush x:Key="AppHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1A000000"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FF1B1E27"/>
    <SolidColorBrush x:Key="AppSidebarBackground" Color="#FFFFFFFF"/>

    <!-- Sidebar tool icons: one colour each. Every style palette must define these: MainWindow reads them with DynamicResource, and where one is missing the icon renders with no color (style C sets them all to its foreground). -->
    <SolidColorBrush x:Key="ToolIconNew" Color="#FF2B6CF0"/>
    <SolidColorBrush x:Key="ToolIconImport" Color="#FF00A38C"/>
    <SolidColorBrush x:Key="ToolIconRestore" Color="#FF8E44D6"/>
    <SolidColorBrush x:Key="ToolIconSettings" Color="#FFEA6F0C"/>
    <SolidColorBrush x:Key="ToolIconAbout" Color="#FF0C93B0"/>
    <SolidColorBrush x:Key="ToolIconExit" Color="#FFD93838"/>

    <!-- Window button icons (minimize, maximize/restore, close). Every style palette must define these. -->
    <SolidColorBrush x:Key="WindowIconMinimize" Color="#FFD99100"/>
    <SolidColorBrush x:Key="WindowIconMaximize" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="WindowIconClose" Color="#FFD93838"/>

</ResourceDictionary>

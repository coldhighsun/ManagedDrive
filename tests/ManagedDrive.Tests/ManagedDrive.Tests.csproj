<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <MinVerSkip>true</MinVerSkip>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!--
      Many tests block a pool thread synchronously (sync-over-async pipe clients, Parallel.For
      saves) while a fake server's Task.Run needs another one to make progress. On a small CI
      runner the pool starts at one thread per core and only grows slowly, so those tests could
      starve each other for tens of seconds and trip their timeouts.
    -->
    <ThreadPoolMinThreads>64</ThreadPoolMinThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ManagedDrive.Core\ManagedDrive.Core.csproj" />
    <ProjectReference Include="..\..\src\ManagedDrive.App\ManagedDrive.App.csproj" />
    <ProjectReference Include="..\..\src\ManagedDrive.Service\ManagedDrive.Service.csproj" />
    <ProjectReference Include="..\..\src\ManagedDrive.Cli\ManagedDrive.Cli.csproj" />
    <ProjectReference Include="..\..\src\ManagedDrive.WingetExtension\ManagedDrive.WingetExtension.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ManagedDrive.App.Controls" />
    <Using Include="ManagedDrive.App.Infrastructure" />
    <Using Include="ManagedDrive.Core.Archive" />
    <Using Include="ManagedDrive.Core.DiskCreation" />
    <Using Include="ManagedDrive.Core.FileSystem" />
    <Using Include="ManagedDrive.Core.Mounting" />
    <Using Include="ManagedDrive.Core.Persistence" />
    <Using Include="ManagedDrive.Core.Snapshots" />
  </ItemGroup>

</Project>

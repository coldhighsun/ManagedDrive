<UserControl x:Class="ManagedDrive.App.Controls.DiskReadOnlyInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ManagedDrive.App.Controls">
    <!-- What a read-only disk's card shows where a normal disk has its usage bar, last-modified line and speed row:
         where the content comes from, how much of it there is, and the read speed. It is laid out in the same three
         rows (about the same heights), so a read-only card is as tall as a normal one. -->
    <StackPanel>
        <!-- Source: kind icon, file name and folder -->
        <StackPanel Orientation="Horizontal" Margin="0,3,0,3" ToolTip="{Binding SourcePath}">
            <TextBlock Margin="0,0,6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppForegroundLight}"/>
                        <Setter Property="Text" Value="&#xE74E;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsArchiveSource}" Value="True">
                                <Setter Property="Text" Value="&#xE7B8;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360">
                <Run FontWeight="Medium" Foreground="{DynamicResource AppForeground}" Text="{Binding SourceFileName, Mode=OneWay}"/>
                <Run Foreground="{DynamicResource AppForegroundLight}" Text="{Binding SourceDirectory, Mode=OneWay, StringFormat='   {0}'}"/>
            </TextBlock>
        </StackPanel>

        <!-- Items and source kind, in the place of "last modified" -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="10"
                       Foreground="{DynamicResource AppForegroundLight}"
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource AppForegroundLight}">
                <Run Text="{Binding ItemCountText, Mode=OneWay}"/>
                <Run Text=" · "/>
                <Run Text="{Binding SourceKindText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- Read speed only: a read-only disk is never written -->
        <controls:DiskSpeedRow ShowWrite="False"/>
    </StackPanel>
</UserControl>

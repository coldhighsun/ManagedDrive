<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppPrimary" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#0C5A9E"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#FFE1ECFB"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF5F6672"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF5F6672"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AppDivider" Color="#33000000"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FFE3E6EC"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="AppWarning" Color="#E08A00"/>
    <SolidColorBrush x:Key="AppHover" Color="#17000000"/>
    <SolidColorBrush x:Key="AppPressed" Color="#2E000000"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="AppChartWrite" Color="#E64A19"/>

    <!-- Semantic and accent colours (shared by every style; style palettes do not override them). -->
    <SolidColorBrush x:Key="AppWarningSoft" Color="#26E08A00"/>
    <SolidColorBrush x:Key="AppSuccess" Color="#1E9E5A"/>
    <SolidColorBrush x:Key="AppSuccessSoft" Color="#261E9E5A"/>
    <SolidColorBrush x:Key="AppDanger" Color="#D93838"/>
    <SolidColorBrush x:Key="AppDangerSoft" Color="#26D93838"/>
    <SolidColorBrush x:Key="AppInfo" Color="#0C93B0"/>
    <SolidColorBrush x:Key="AppInfoSoft" Color="#260C93B0"/>
    <SolidColorBrush x:Key="AppAccent1" Color="#2B6CF0"/>
    <SolidColorBrush x:Key="AppAccent2" Color="#00A38C"/>
    <SolidColorBrush x:Key="AppAccent3" Color="#8E44D6"/>
    <SolidColorBrush x:Key="AppAccent4" Color="#EA6F0C"/>
    <SolidColorBrush x:Key="AppAccent5" Color="#D93A7A"/>
    <SolidColorBrush x:Key="AppAccent6" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AppAccentSoft1" Color="#262B6CF0"/>
    <SolidColorBrush x:Key="AppAccentSoft2" Color="#2600A38C"/>
    <SolidColorBrush x:Key="AppAccentSoft3" Color="#268E44D6"/>
    <SolidColorBrush x:Key="AppAccentSoft4" Color="#26EA6F0C"/>
    <SolidColorBrush x:Key="AppAccentSoft5" Color="#26D93A7A"/>
    <SolidColorBrush x:Key="AppAccentSoft6" Color="#264F46E5"/>

    <!-- Space usage treemap: one colour per file category, plus folders and the merged small-items block. -->
    <!-- Same muted, colour-blind-friendly hues as the dark palette (white cell labels need them this dark in both themes). -->
    <SolidColorBrush x:Key="AppSpaceImage" Color="#357A2B"/>
    <SolidColorBrush x:Key="AppSpaceVideo" Color="#A8527F"/>
    <SolidColorBrush x:Key="AppSpaceAudio" Color="#1F7F8E"/>
    <SolidColorBrush x:Key="AppSpaceArchive" Color="#A66300"/>
    <SolidColorBrush x:Key="AppSpaceDocument" Color="#0072B2"/>
    <SolidColorBrush x:Key="AppSpaceCode" Color="#3B3F7A"/>
    <SolidColorBrush x:Key="AppSpaceExecutable" Color="#8E1B2E"/>
    <SolidColorBrush x:Key="AppSpaceCache" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="AppSpaceOther" Color="#5E7480"/>
    <SolidColorBrush x:Key="AppSpaceFolder" Color="#455A64"/>
    <SolidColorBrush x:Key="AppSpaceMerged" Color="#CFD8DC"/>

</ResourceDictionary>

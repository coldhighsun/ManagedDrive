<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Style C (minimal), light: warm off-white, black accent. Merged after the theme's colors by StyleManager, so these win. -->

    <SolidColorBrush x:Key="AppPrimary" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#FF454545"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#0F1C1C1C"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF6B6B66"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF6B6B66"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FFFAFAF8"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AppDivider" Color="#FFE4E4DF"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FFD9D9D3"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FFFAFAF8"/>
    <SolidColorBrush x:Key="AppWarning" Color="#FFC26A00"/>
    <SolidColorBrush x:Key="AppHover" Color="#0D000000"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1A000000"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FFFAFAF8"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FF1C1C1C"/>

    <!-- Toolbar icons: minimal style is monochrome (see the dark palette). -->
    <SolidColorBrush x:Key="ToolIconNew" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="ToolIconImport" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="ToolIconRestore" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="ToolIconSettings" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="ToolIconAbout" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="ToolIconExit" Color="#FF1C1C1C"/>

    <!-- Window button icons: monochrome too. -->
    <SolidColorBrush x:Key="WindowIconMinimize" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="WindowIconMaximize" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="WindowIconClose" Color="#FF1C1C1C"/>

</ResourceDictionary>

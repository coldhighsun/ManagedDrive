<views:DialogWindowBase x:Class="ManagedDrive.App.Views.RestoreSnapshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ManagedDrive.App.Views"
        Style="{DynamicResource DialogWindowStyle}"
        Title="{DynamicResource RestoreSnapshot.Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="SourceDescriptionText"
                   Foreground="{DynamicResource AppForeground}"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
        <Border Style="{DynamicResource SectionBorder}">
            <StackPanel>
                <TextBlock x:Name="NoSnapshotsText"
                           Text="{DynamicResource RestoreSnapshot.NoneWarning}"
                           Foreground="{DynamicResource AppWarning}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="SnapshotCountText"
                           Foreground="{DynamicResource AppForeground}"
                           FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,4"/>

                <ListBox x:Name="SnapshotListBox" MaxHeight="260"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource AppForeground}"
                         ItemContainerStyle="{StaticResource DialogListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"/>
            </StackPanel>
        </Border>

        <!-- Shown over the list while a snapshot is being deleted. -->
        <Border x:Name="DeletingOverlay" Visibility="Collapsed"
                Background="{DynamicResource AppSurface}" Opacity="0.92"
                CornerRadius="{DynamicResource SectionCornerRadius}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="28"
                           Foreground="{DynamicResource AppPrimary}"
                           HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="DeletingSpinnerRotate" Angle="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="{DynamicResource RestoreSnapshot.Deleting}" Margin="0,10,0,0"
                           Foreground="{DynamicResource AppForegroundLight}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        </Grid>

        <!-- View changes / OK / Cancel -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="ViewChangesButton"
                        Content="{DynamicResource RestoreSnapshot.ViewChanges}"
                        Style="{StaticResource FlatButton}"
                        Click="ViewChanges_Click"
                        Margin="0,0,16,0"/>
                <Button x:Name="DeleteButton"
                        Content="{DynamicResource RestoreSnapshot.Delete}"
                        Style="{StaticResource FlatButton}"
                        Foreground="{DynamicResource AppWarning}"
                        Click="Delete_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Btn.Cancel}" Width="80" IsCancel="True"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0"/>
                <Button x:Name="OkButton"
                        Content="{DynamicResource Btn.Ok}" Width="80" IsDefault="True"
                        Click="OK_Click"
                        Style="{StaticResource RaisedButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</views:DialogWindowBase>

<UserControl x:Class="ManagedDrive.App.Controls.DiskSpeedRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ManagedDrive.App.Controls">
    <!-- Read/write throughput of a disk card; hovering opens a history-chart popup. The Border enlarges the
         hover hit-test area beyond the tight text/icon bounds. -->
    <Border x:Name="SpeedHoverArea" Background="Transparent" Padding="0,4,0,4" Margin="0,-2,0,-4"
                                                Tag="{Binding ElementName=SpeedPopup}">
                                            <StackPanel x:Name="SpeedRow" Orientation="Horizontal">
                                                <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                           Foreground="{DynamicResource AppForegroundLight}"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                                           ToolTip="{DynamicResource Card.ReadSpeed}"
                                                           AutomationProperties.Name="{DynamicResource Card.ReadSpeed}"/>
                                                <TextBlock Text="{Binding ReadSpeedFormatted}" FontSize="{DynamicResource FontSizeSmall}" Width="62"
                                                           TextAlignment="Left"
                                                           Foreground="{DynamicResource AppForegroundLight}"/>
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                           Foreground="{DynamicResource AppForegroundLight}"
                                                           VerticalAlignment="Center" Margin="10,0,4,0"
                                                           ToolTip="{DynamicResource Card.WriteSpeed}"
                                                           AutomationProperties.Name="{DynamicResource Card.WriteSpeed}"/>
                                                <TextBlock Text="{Binding WriteSpeedFormatted}" FontSize="{DynamicResource FontSizeSmall}" Width="62"
                                                           TextAlignment="Left"
                                                           Foreground="{DynamicResource AppForegroundLight}"/>
                                                <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedHoverArea}" Placement="Bottom"
                                                       StaysOpen="True" AllowsTransparency="True">
                                                    <Border Background="{DynamicResource AppSurface}"
                                                            BorderBrush="{DynamicResource AppDivider}"
                                                            BorderThickness="1" CornerRadius="{DynamicResource PopupCornerRadius}" Padding="8"
                                                            x:Name="PopupBorder"
                                                            Tag="{Binding ElementName=SpeedPopup}">
                                                        <StackPanel>
                                                            <controls:SpeedHistoryChart ReadHistory="{Binding ReadSpeedHistory}"
                                                                                         WriteHistory="{Binding WriteSpeedHistory}"/>
                                                            <TextBlock FontSize="{DynamicResource FontSizeSmall}" Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource AppForegroundLight}">
                                                                <Run Text="{DynamicResource Card.TotalReadWritten}"/>
                                                                <Run Text="{Binding TotalReadFormatted, Mode=OneWay}"/>
                                                                <Run Text="/"/>
                                                                <Run Text="{Binding TotalWrittenFormatted, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </StackPanel>
                                        </Border>
</UserControl>

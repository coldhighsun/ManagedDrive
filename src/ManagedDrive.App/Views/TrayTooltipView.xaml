<UserControl x:Class="ManagedDrive.App.Views.TrayTooltipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:ManagedDrive.App.Infrastructure"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <infra:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppDivider}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PopupCornerRadius}"
            Padding="12,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              Direction="270"
                              Opacity="0.15"
                              ShadowDepth="4" />
        </Border.Effect>

        <StackPanel>
            <ItemsControl x:Name="DiskList"
                          ItemsSource="{Binding Disks}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- No boxed track: the text sits directly on the popup and the usage is a thin bar underneath. -->
                        <StackPanel Margin="0,5" MinWidth="190">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppForeground}"
                                           Text="{Binding MountPoint}"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppForeground}"
                                           Text="{Binding VolumeLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource AppForegroundLight}"
                                           Text="{Binding UsedPercent, StringFormat={}{0:F0}%}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="3" Margin="0,4,0,0" CornerRadius="1.5" ClipToBounds="True"
                                    Background="{DynamicResource AppProgressTrack}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding UsedPercent, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Fill}" />
                                        <ColumnDefinition Width="{Binding UsedPercent, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Remainder}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UsageLevel}" Value="High">
                                                        <Setter Property="Background" Value="{DynamicResource AppWarning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UsageLevel}" Value="Critical">
                                                        <Setter Property="Background" Value="{DynamicResource AppDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="13"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource AppForegroundLight}"
                       Text="{Binding AutoMountStatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoMounting}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock FontSize="13"
                       Foreground="{DynamicResource AppForegroundLight}"
                       Text="{Binding NoDisksMountedText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=DiskList, Path=HasItems}" Value="False" />
                                    <Condition Binding="{Binding IsAutoMounting}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Footer is a tinted chip with an icon, not a hairline, so it cannot be mistaken for a usage bar. -->
            <Border Background="{DynamicResource AppHover}"
                    CornerRadius="4"
                    Padding="8,5"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource AppForegroundLight}"
                               Text="&#xE950;"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource AppForegroundLight}"
                               Text="{Binding AvailableMemoryFormatted}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

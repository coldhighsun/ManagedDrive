<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Style B (dashboard), dark: blue-black with a bright blue accent. Merged after the theme's colors by StyleManager, so these win. -->

    <SolidColorBrush x:Key="AppPrimary" Color="#FF4F8DF7"/>
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#FF3A74DB"/>
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#334F8DF7"/>
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="White"/>
    <SolidColorBrush x:Key="AppForeground" Color="#FFE7E9EE"/>
    <SolidColorBrush x:Key="AppForegroundLight" Color="#FF8D95A6"/>
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF8D95A6"/>
    <SolidColorBrush x:Key="AppBackground" Color="#FF12141A"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FF1B1E27"/>
    <SolidColorBrush x:Key="AppDivider" Color="#FF2A2F3B"/>
    <SolidColorBrush x:Key="AppProgressTrack" Color="#FF2A2F3B"/>
    <SolidColorBrush x:Key="AppToolBarBackground" Color="#FF12141A"/>
    <SolidColorBrush x:Key="AppWarning" Color="#FFF0B04A"/>
    <SolidColorBrush x:Key="AppWarningSoft" Color="#33F0B04A"/>
    <SolidColorBrush x:Key="AppHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AppPressed" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="AppBarBackground" Color="#FF12141A"/>
    <SolidColorBrush x:Key="AppBarForeground" Color="#FFE7E9EE"/>
    <SolidColorBrush x:Key="AppSidebarBackground" Color="#FF0D0F14"/>

    <!-- Sidebar tool icons: one colour each. Every style palette must define these: MainWindow reads them with DynamicResource, and where one is missing the icon renders with no color (style C sets them all to its foreground). -->
    <SolidColorBrush x:Key="ToolIconNew" Color="#FF4F8DF7"/>
    <SolidColorBrush x:Key="ToolIconImport" Color="#FF2DD4BF"/>
    <SolidColorBrush x:Key="ToolIconRestore" Color="#FFB388F5"/>
    <SolidColorBrush x:Key="ToolIconSettings" Color="#FFFF9A4D"/>
    <SolidColorBrush x:Key="ToolIconAbout" Color="#FF3CC4DD"/>
    <SolidColorBrush x:Key="ToolIconExit" Color="#FFFF6B6B"/>

    <!-- Window button icons (minimize, maximize/restore, close). Every style palette must define these. -->
    <SolidColorBrush x:Key="WindowIconMinimize" Color="#FFF5B83D"/>
    <SolidColorBrush x:Key="WindowIconMaximize" Color="#FF34D399"/>
    <SolidColorBrush x:Key="WindowIconClose" Color="#FFFF6B6B"/>

</ResourceDictionary>
